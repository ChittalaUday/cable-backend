local.file_match "backend_logs" {
  path_targets = [{ "__path__" = "/var/log/backends/*/*/*.log" }]
}

loki.source.file "backend_logs" {
  targets    = local.file_match.backend_logs.targets
  forward_to = [loki.process.backend_logs.receiver]
}

loki.process "backend_logs" {
  stage.regex {
    source     = "filename"
    expression = "/var/log/backends/(?P<service>[^/]+)/.*"
  }

  stage.json {
    expressions = {
      level = "level",
      time  = "time",
    }
  }

  stage.timestamp {
    source = "time"
    format = "UnixMs"
  }

  stage.labels {
    values = {
      level   = "",
      service = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
