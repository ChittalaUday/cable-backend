      "targets": [{ "expr": "topk(10, 1000 * sum by (service, instance, method, route) (rate(http_request_duration_seconds_sum{service=~\"${service:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval])) / sum by (service, instance, method, route) (rate(http_request_duration_seconds_count{service=~\"${service:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval])))", "format": "table", "instant": true, "refId": "A" }],
      "title": "Slowest endpoints (average)",
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true }, "renameByName": { "Value": "Average response time" } } }],
