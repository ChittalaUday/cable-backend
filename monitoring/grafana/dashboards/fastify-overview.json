          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Slowest endpoints (average)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value": "Average response time"
            }
