      "targets": [{ "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=~\"${service:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval])))", "refId": "A" }],
