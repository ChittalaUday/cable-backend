      "targets": [{ "expr": "1000 * sum(rate(http_request_duration_seconds_sum{service=~\"${service:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval])) / sum(rate(http_request_duration_seconds_count{service=~\"${service:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval]))", "refId": "A" }],
      "title": "Average response time",
      "type": "stat"
    },
