      "options": { "dedupStrategy": "none", "enableInfiniteScrolling": false, "prettifyLogMessage": true, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{service=~\"${service:regex}\"}", "maxLines": 10, "queryType": "range", "refId": "A" }],
      "title": "Backend logs",
      "type": "logs"
    }
