# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5050
HOST=0.0.0.0
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://cable:cable@localhost:5432/cable
DATABASE_POOL_MAX=10

# ─── Auth (§4.3) ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-48-byte-random-string-before-running-anywhere
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MAX_SESSIONS_PER_DEVICE=5

# Google sign-in: the OAuth client IDs the mobile app uses. Comma separated.
GOOGLE_CLIENT_IDS=

# ─── CORS (§2) ────────────────────────────────────────────────────────────────
# Comma separated origins. Empty in development allows any origin.
CORS_ORIGINS=

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# ─── Messaging / OTP (§1, §4.3) ───────────────────────────────────────────────
# false → the log provider: OTPs are written to the server log, nothing is sent.
MESSAGING_ENABLED=false
MESSAGING_BASE_URL=http://localhost:2785
MESSAGING_API_KEY=
MESSAGING_SESSION_ID=
MESSAGING_TIMEOUT_MS=8000
MESSAGING_DEFAULT_CHANNEL=whatsapp
DEFAULT_COUNTRY_CODE=91

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── Tests ────────────────────────────────────────────────────────────────────
# Put this in .env.test to run the suite against a local PostgreSQL 18 instead
# of a Testcontainers instance:
#   DATABASE_URL_TEST=postgres://<user>@127.0.0.1:5432/cable_test
