# ─── Runtime ──────────────────────────────────────────────────────────────────
# NODE_ENV is Node's flag. APP_ENV is the deployment tier and decides policy
# (TLS, error detail, CORS, docs) — see AGENTS.md §2.1.
#   local      NODE_ENV=development  APP_ENV=local
#   staging    NODE_ENV=production   APP_ENV=staging
#   production NODE_ENV=production   APP_ENV=production
NODE_ENV=development
APP_ENV=local
PORT=5050
HOST=0.0.0.0
LOG_LEVEL=debug
# What reaches the files. The console still gets LOG_LEVEL; a line per request
# is worth watching and not worth keeping. Raise to warn or info to debug an
# incident, then put it back.
LOG_FILE_LEVEL=error
# JSON logs are stored in LOG_DIRECTORY/YYYY-MM-DD and split at this size.
LOG_DIRECTORY=./logs
LOG_MAX_FILE_BYTES=10485760
# The PostgreSQL-backed worker deletes dated folders older than this.
LOG_RETENTION_DAYS=30
LOG_CLEANUP_CRON=0 2 * * *
STORAGE_CLEANUP_CRON=0 2 * * *
JOB_HISTORY_RETENTION_DAYS=30

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://cable:cable@localhost:5432/cable
DATABASE_POOL_MAX=10
# disable | require | verify-full. Production refuses to boot on `disable`.
DATABASE_SSL=disable

# ─── Auth (§4.3) ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-48-byte-random-string-before-running-anywhere
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MAX_SESSIONS_PER_DEVICE=5

# Google sign-in: the OAuth client IDs the mobile app uses. Comma separated.
GOOGLE_CLIENT_IDS=

# ─── CORS (§2) ────────────────────────────────────────────────────────────────
# Comma separated origins. Empty in development allows any origin.
CORS_ORIGINS=

# How long after a rotation the just-consumed refresh token is still treated as a
# retry rather than theft. Covers a rotation whose response never reached the
# phone — including one it only retries after a restart. 0 disables the grace.
REFRESH_REUSE_GRACE_SECONDS=60

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
SIGN_IN_RATE_LIMIT_MAX=10
OTP_VERIFY_RATE_LIMIT_MAX=5
OTP_REQUEST_RATE_LIMIT_MAX=3
LOGIN_RATE_LIMIT_MAX=10

# ─── Messaging / OTP (§1, §4.3) ───────────────────────────────────────────────
# false → the log provider: OTPs are written to the server log, nothing is sent.
MESSAGING_ENABLED=false
MESSAGING_BASE_URL=http://localhost:2785
MESSAGING_API_KEY=
MESSAGING_SESSION_ID=
MESSAGING_TIMEOUT_MS=8000
MESSAGING_DEFAULT_CHANNEL=whatsapp
DEFAULT_COUNTRY_CODE=91

# Firebase Admin service account JSON file path.
FIREBASE_SERVICE_ACCOUNT_PATH=

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── Tests ────────────────────────────────────────────────────────────────────
# Set this to run test suites against a local PostgreSQL 18 instead of Testcontainers
DATABASE_URL_TEST=

# ─── Bootstrap super admin (§4.2) ─────────────────────────────────────────────
# Read by `pnpm db:seed` only. Leave blank to skip creating the account.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# ─── Sign-in methods the login screen offers ──────────────────────────────────
# GET /auth/config reports these to the app, so it only draws what works.

# false → email + password signs in outright.
# true  → the password is answered with a challenge token, and an emailed code
#         finishes the sign-in. Needs RESEND_* below; without a sender the flag
#         is reported as off rather than locking everyone out.
EMAIL_OTP_ENABLED=false

# Email delivery. Rotate the key if it has ever been pasted anywhere.
RESEND_API_KEY=
RESEND_FROM=Satya Cable <no-reply@example.invalid>

# SMS, which is also what WhatsApp falls back to. TWILIO_FROM takes an E.164
# number or a Messaging Service SID (MG…). Unset → WhatsApp has no fallback.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Consecutive failures that take a channel out of rotation, and how long it
# stays out before one send decides whether it is back. In memory: a restart
# clears it, because an outage is meant to pass.
MESSAGING_BREAKER_FAILURES=3
MESSAGING_BREAKER_COOLDOWN_SECONDS=120

# ─── Object storage: Cloudflare R2 (§8.4) ─────────────────────────────────────
# Unset → every file endpoint returns 503 naming these variables.
R2_ACCOUNT_ID=
R2_ENDPOINT=
# Set R2_JURISDICTION (e.g. eu, fedramp) if using a jurisdiction-specific endpoint:
R2_JURISDICTION=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
CLOUDFLARE_R2_TOKEN=

UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=20971520
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ─── Cache (§8.5) ─────────────────────────────────────────────────────────────
# Pick a DB index and prefix that no other project on this Redis uses.
CACHE_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/2
CACHE_TTL_SECONDS=300
CACHE_PREFIX=cable:

