{
  "name": "cable-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Satya Cable & Broadband backend API",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "verify": "tsx --env-file-if-exists=.env src/verify.ts",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "check-all": "pnpm run lint && pnpm run type-check && pnpm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:migrate:test": "tsx --env-file-if-exists=.env.test src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed/index.ts",
    "db:up": "docker compose up -d postgres",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@fastify/autoload": "^6.3.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/under-pressure": "^9.0.3",
    "@node-rs/argon2": "^2.0.2",
    "close-with-grace": "^2.2.0",
    "decimal.js": "^10.5.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.4.0",
    "fastify-plugin": "^6.0.0",
    "firebase-admin": "^14.4.0",
    "google-auth-library": "^11.0.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.16.0",
    "pino": "^10.3.1",
    "typebox": "^1.3.30"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.15.4",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "pino-pretty": "^13.0.0",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.20.1",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  }
}
