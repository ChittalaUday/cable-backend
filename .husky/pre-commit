echo ">> Checking branch name..."
if [ -z "$SKIP_BRANCH_PROTECTION" ]; then
  # symbolic-ref works before the first commit exists; rev-parse does not.
  BRANCH=$(git symbolic-ref --short -q HEAD || echo "detached")
  case "$BRANCH" in
    main|master)
      echo ">> Direct commits to $BRANCH are not allowed. Create a branch,"
      echo "   or set SKIP_BRANCH_PROTECTION=1 for a deliberate exception."
      exit 1
      ;;
  esac
else
  echo ">> Skipping branch protection."
fi

echo ">> Checking for staged secrets and credentials..."
FORBIDDEN_STAGED=$(git diff --cached --name-only | grep -iE '(adminsdk|service.*account|secrets/|\.env(\.|$))' | grep -v '\.env\.example' || true)
if [ -n "$FORBIDDEN_STAGED" ]; then
  echo "❌ SECURITY ALERT: Commit blocked! Staged files contain sensitive credentials or secret files:"
  echo "$FORBIDDEN_STAGED"
  exit 1
fi

echo ">> Type checking..."
pnpm type-check

echo ">> Linting staged files..."
pnpm exec lint-staged
